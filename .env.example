# Salin file ini menjadi ".env" lalu isi sesuai environment Anda.
# JANGAN commit file ".env" (sudah ada di .gitignore).

# --- Database (container venambak-timescaledb) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=venambak_crm
DB_USER=venambak
DB_PASSWORD=isi_password_disini

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- JWT ---
# Generate secret acak, contoh: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=isi_dengan_secret_acak_yang_panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- CORS ---
# Alamat frontend Anda, pisahkan dengan koma kalau lebih dari satu.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
